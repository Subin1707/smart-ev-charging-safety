{
  "id": "AUTH",
  "name": "Vehicle entry/exit authentication",
  "description": "Vehicle connection, token validation, authentication success/failure, and disconnect auth reset.",
  "source_references": [
    "src/auth/xac_thuc.c",
    "src/station/tram_sac.c"
  ],
  "parameters": [
    {
      "symbol": "C",
      "name": "connected",
      "domain": [0, 1]
    },
    {
      "symbol": "T",
      "name": "token_valid",
      "domain": [0, 1]
    },
    {
      "symbol": "A",
      "name": "authenticated",
      "domain": [0, 1]
    },
    {
      "symbol": "X",
      "name": "disconnect_request",
      "domain": [0, 1]
    }
  ],
  "state_encoding": ["C", "T", "A", "X"],
  "initial_state": {
    "C": 0,
    "T": 0,
    "A": 0,
    "X": 0
  },
  "constraints": [
    {
      "id": "AUTH-01",
      "formula": "A -> C",
      "expression": "(not A) or C",
      "scope": "state",
      "description": "Authenticated vehicle must already be connected."
    },
    {
      "id": "AUTH-02",
      "formula": "A -> T",
      "expression": "(not A) or T",
      "scope": "state",
      "description": "Authentication success requires a valid token."
    },
    {
      "id": "AUTH-03",
      "formula": "!C -> !A",
      "expression": "C or (not A)",
      "scope": "state",
      "description": "A disconnected vehicle cannot remain authenticated."
    },
    {
      "id": "AUTH-04",
      "formula": "X -> next(!A)",
      "scope": "transition",
      "description": "After disconnect completes, authentication is cleared."
    }
  ],
  "requirements": [
    {
      "id": "REQ-AUTH-01",
      "type": "safety",
      "priority": "HIGH",
      "text": "Vehicle authentication may succeed only when the vehicle is connected and the token is valid.",
      "formal": "A -> (C && T)",
      "constraints": ["AUTH-01", "AUTH-02"]
    },
    {
      "id": "REQ-AUTH-02",
      "type": "safety",
      "priority": "HIGH",
      "text": "When a vehicle disconnects from the station, authentication must be cleared.",
      "formal": "X -> next(!A)",
      "constraints": ["AUTH-03", "AUTH-04"]
    }
  ],
  "example_states": [
    {
      "id": "S0",
      "bits": "0000",
      "meaning": "not connected"
    },
    {
      "id": "S1",
      "bits": "1000",
      "meaning": "connected, not authenticated"
    },
    {
      "id": "S2",
      "bits": "1100",
      "meaning": "connected with valid token before auth completion"
    },
    {
      "id": "S3",
      "bits": "1110",
      "meaning": "authentication succeeded"
    },
    {
      "id": "S4",
      "bits": "1111",
      "meaning": "vehicle requests disconnect after authenticated session"
    }
  ],
  "transitions": [
    {
      "from": "S0",
      "event": "connect",
      "to": "S1"
    },
    {
      "from": "S1",
      "event": "valid_token",
      "to": "S2"
    },
    {
      "from": "S2",
      "event": "authenticate_success",
      "to": "S3"
    },
    {
      "from": "S3",
      "event": "disconnect_request",
      "to": "S4"
    },
    {
      "from": "S4",
      "event": "disconnect_complete",
      "to": "S0"
    }
  ]
}
