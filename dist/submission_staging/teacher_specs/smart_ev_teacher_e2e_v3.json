      ],
      "buffer_size": 32,
      "bug": null
    }
  ],
  "arithmetic_checks": [
    {
      "name": "gd122_req_soc_01_valid_domain",
      "int_vars": [
        "soc"
      ],
      "condition": "soc >= 0 and soc <= 100"
    },
    {
      "name": "gd122_req_soc_01_contradictory_violation",
      "int_vars": [
        "soc"
      ],
      "condition": "soc >= 0 and soc <= 100 and (soc < 0 or soc > 100)"
    },
    {
      "name": "gd122_req_temp_01_overheat_threshold",
      "int_vars": [
        "temperature"
      ],
      "condition": "temperature >= 60"
    },
    {
      "name": "gd122_req_temp_01_contradictory_condition",
      "int_vars": [
        "temperature"
      ],
      "condition": "temperature >= 60 and temperature < 60"
    },
    {
      "name": "gd122_req_temp_01_safe_range",
      "int_vars": [
        "temperature"
      ],
      "condition": "temperature + 20 >= 0 and temperature < 60"
    }
  ]
