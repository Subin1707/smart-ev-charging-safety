  "functions": [
    {
      "name": "handle_auth_token",
      "language": "c",
      "kind": "buffer_copy",
      "params": [
        "token_input"
      ],
      "buffer_size": 32,
      "bug": null
    },
    {
      "name": "compute_charging_rate",
      "language": "python",
      "kind": "divide",
      "params": [
        "energy_kwh",
        "time_hours"
      ]
    }
  ],
  "arithmetic_checks": [
    {
      "name": "req_soc_01_valid_domain",
      "int_vars": [
        "soc"
      ],
      "condition": "soc >= 0 and soc <= 100"
    },
    {
      "name": "req_soc_01_violation_unsat",
      "int_vars": [
        "soc"
      ],
      "condition": "soc >= 0 and soc <= 100 and (soc < 0 or soc > 100)"
    },
    {
      "name": "req_soc_01_overflow_check",
      "int_vars": [
        "soc_current",
        "soc_delta"
      ],
      "overflow_expr": "soc_current + soc_delta"
    },
    {
      "name": "req_temp_01_overheat_threshold",
      "int_vars": [
        "temperature"
      ],
      "condition": "temperature >= 60"
    },
    {
      "name": "req_temp_01_violation_unsat",
      "int_vars": [
        "temperature"
      ],
      "condition": "temperature >= 60 and temperature < 60"
    },
    {
      "name": "req_temp_01_safe_range",
      "int_vars": [
        "temperature"
      ],
      "condition": "temperature < 60"
    },
    {
      "name": "req_soc_01_overflow_v2_bounded",
      "int_vars": [
        "soc_current",
        "soc_delta"
      ],
      "condition": "soc_current >= 0 and soc_current <= 100 and soc_delta >= 0 and soc_delta <= 100",
      "overflow_expr": "soc_current + soc_delta"
    }
  ]
